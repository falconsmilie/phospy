{
  "schema": "phospy.attestation-policy/v1",
  "attestation_schema": "phospy.release-attestation/v1",
  "attestation_schema_version": 1,
  "allow_dirty_git": false,
  "supported_python_versions": [
    "3.10",
    "3.11",
    "3.12"
  ],
  "required_artifact_kinds": [
    "wheel",
    "sdist"
  ],
  "required_artifact_verification_matrix": [
    {
      "artifact_kind": "wheel",
      "python_version": "3.10"
    },
    {
      "artifact_kind": "wheel",
      "python_version": "3.11"
    },
    {
      "artifact_kind": "wheel",
      "python_version": "3.12"
    },
    {
      "artifact_kind": "sdist",
      "python_version": "3.10"
    },
    {
      "artifact_kind": "sdist",
      "python_version": "3.11"
    },
    {
      "artifact_kind": "sdist",
      "python_version": "3.12"
    }
  ],
  "required_verifier_check_names": [
    "artifact-manifest-binding",
    "installed-package-identity",
    "packaged-scientific-resources",
    "corrected-construction-and-provenance-path",
    "corrected-derived-and-ownership-path",
    "corrected-differential-path"
  ],
  "required_report_classes": [
    "scientific",
    "parity",
    "reproducibility",
    "performance",
    "architecture",
    "test"
  ],
  "required_source_suite_report_ids": [
    "release-default-py3.10",
    "release-golden-py3.10",
    "release-reference-manifest-py3.10",
    "release-parity-py3.10",
    "release-performance-py3.10",
    "release-default-py3.11",
    "release-golden-py3.11",
    "release-reference-manifest-py3.11",
    "release-parity-py3.11",
    "release-performance-py3.11",
    "release-default-py3.12",
    "release-golden-py3.12",
    "release-reference-manifest-py3.12",
    "release-parity-py3.12",
    "release-performance-py3.12"
  ],
  "source_suite_report_classes": {
    "release-default-py3.10": [
      "test",
      "architecture"
    ],
    "release-golden-py3.10": [
      "reproducibility"
    ],
    "release-reference-manifest-py3.10": [
      "scientific"
    ],
    "release-parity-py3.10": [
      "parity"
    ],
